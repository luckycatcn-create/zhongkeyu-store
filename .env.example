# Supabase (Postgres) — REQUIRED on Vercel so messages/products persist.
# Create a free project at https://supabase.com, then copy these from
# Project Settings → API. Use the "service_role" key (server-side only).
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin backend password (optional; defaults to ADMIN336 if unset).
ADMIN_PASSWORD=ADMIN336
